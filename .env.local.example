# Supabase — create a project at https://supabase.com/dashboard
# Copy these from Settings → API in your Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Public site URL — the deployed app's URL. Used for auth redirect links
# (e.g. password-reset emails) so they always point at the deployed app
# instead of localhost. Set this in Vercel project settings to your
# production domain. If unset, the app falls back to the current origin.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
